      "memory_action_policy": "raw"
    },
    {
      "id": "text-memory-admissible-only",
      "carrier": "text-memory",
      "memory_action_policy": "admissible-only"
    }
  ],
  "controls": [
    "Same frozen H1.14 train-only recovery corpus, top-1 token-set retrieval, model, prompt, parser, environment, task panel, rollout seeds, temperature, and step/token caps.",
    "Only the retrieved action field changes: if exact action is absent from current Allowed actions, admissible-only injects state only; it never substitutes another action."
  ],
