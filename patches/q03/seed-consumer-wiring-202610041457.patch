+def _rollout_seed_for_dp_rank(engine_seed, dp_rank):
+    if engine_seed is None:
+        return int(dp_rank) + 1000
+    material = f"verl.rollout.engine_seed.v1:{int(engine_seed)}:{int(dp_rank)}".encode("ascii")
+    return int.from_bytes(hashlib.sha256(material).digest()[:8], byteorder="big", signed=False)
+
+
+def _validate_rollout_rng_state_payload(
+    state, *, engine_seed, dp_rank, derived_seed, expected_shape, expected_dtype, tensor_type
+):
+    if engine_seed is None:
+        raise RuntimeError("checkpoint contains rollout RNG but rollout.engine_seed is unset")
+    if not isinstance(state, dict) or state.get("version") != 1:
+        raise ValueError("unsupported rollout RNG checkpoint state")
+    if int(state.get("engine_seed", -1)) != int(engine_seed):
+        raise ValueError("rollout RNG checkpoint engine_seed mismatch")
+    if int(state.get("dp_rank", -1)) != int(dp_rank):
+        raise ValueError("rollout RNG checkpoint dp_rank mismatch")
+    if int(state.get("derived_seed", -1)) != int(derived_seed):
+        raise ValueError("rollout RNG checkpoint derived seed mismatch")
+    rng_state = state.get("gen_random_states")
+    if not isinstance(rng_state, tensor_type):
+        raise ValueError("rollout RNG checkpoint state must be a tensor")
+    if rng_state.dtype != expected_dtype or tuple(rng_state.shape) != tuple(expected_shape):
+        raise ValueError("rollout RNG checkpoint tensor dtype or shape mismatch")
+    if getattr(getattr(rng_state, "device", None), "type", None) != "cpu":
+        raise ValueError("rollout RNG checkpoint tensor must be on CPU")
+    if len(tuple(rng_state.shape)) != 1 or int(rng_state.numel()) <= 0:
+        raise ValueError("rollout RNG checkpoint tensor must be a non-empty vector")
+    return rng_state
+
+
+def _isolate_explicit_rollout_session_entry(method):
+    from functools import wraps
+
+    @wraps(method)
+    def enter(self, *args, **kwargs):
+        if self.rollout_engine_seed is None:
+            return method(self, *args, **kwargs)
+        from verl.utils.checkpoint.checkpoint_manager import BaseCheckpointManager
+
+        if getattr(self, "_q03_learner_rng_state", None) is not None:
+            raise RuntimeError("explicit rollout RNG session is already entered")
+        self._q03_learner_rng_state = BaseCheckpointManager.get_rng_state()
+        try:
+            return method(self, *args, **kwargs)
+        except BaseException:
+            BaseCheckpointManager.load_rng_state(self._q03_learner_rng_state)
+            self._q03_learner_rng_state = None
+            raise
+
+    return enter
+
+
+def _isolate_explicit_rollout_session_exit(method):
+    from functools import wraps
+
+    @wraps(method)
+    def exit(self, *args, **kwargs):
+        if self.rollout_engine_seed is None:
+            return method(self, *args, **kwargs)
+        from verl.utils.checkpoint.checkpoint_manager import BaseCheckpointManager
+
+        learner_rng = getattr(self, "_q03_learner_rng_state", None)
+        if learner_rng is None:
+            raise RuntimeError("explicit rollout RNG session has no learner state")
+        try:
+            return method(self, *args, **kwargs)
+        finally:
+            BaseCheckpointManager.load_rng_state(learner_rng)
+            self._q03_learner_rng_state = None
+
+    return exit
