{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mykcs/openevo-experiment/schemas/passport-accelerated-gdr-resource-topology-202609142055.schema.json",
  "title": "Accelerated-GDR Passport shadow resource topology identity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "openevo.accelerated-gdr-resource-topology.202609142055"},
    "topology_id": {"enum": ["FOUR_GPU_2_WORKERS_PER_GPU", "TWO_GPU_PER_ARM_1_WORKER_PER_GPU"]},
    "gpu_count": {"type": "integer", "minimum": 1},
    "gpus_per_arm": {"type": ["integer", "null"], "minimum": 1},
    "workers_per_gpu": {"type": "integer", "minimum": 1},
    "total_workers": {"type": "integer", "minimum": 1},
    "co_resident": {"type": "boolean"},
    "baseline_workers": {"type": "integer", "minimum": 1},
    "gdr_workers": {"type": "integer", "minimum": 1},
    "arm_partition_policy": {"type": "string", "minLength": 1},
    "gpu_uuid_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "model_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "schema",
    "topology_id",
    "gpu_count",
    "gpus_per_arm",
    "workers_per_gpu",
    "total_workers",
    "co_resident",
    "baseline_workers",
    "gdr_workers",
    "arm_partition_policy",
    "gpu_uuid_set_sha256",
    "runtime_image_digest",
    "model_identity_sha256",
    "resource_contract_sha256"
  ]
}
