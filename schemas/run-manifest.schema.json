{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mykcs/openevo-experiment/schemas/run-manifest.schema.json",
  "title": "OpenEvo Run Manifest",
  "description": "Portable provenance receipt. Tracking identifiers are optional cross-links, never the sole record of a run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "server", "hardware", "code", "model", "data", "experiment", "command", "outputs", "resources", "tracking"],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "timestamp", "phase", "status"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "phase": {"enum": ["phase_c", "phase_d", "phase_e", "phase_f", "phase_g", "phase_h"]},
        "status": {"enum": ["planned", "running", "pass", "fail", "blocked", "cancelled"]}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_identity", "control_plane", "experiment_container", "image_tag", "image_digest"],
      "properties": {
        "server_identity": {"type": ["string", "null"]},
        "control_plane": {"type": ["string", "null"]},
        "experiment_container": {"type": ["string", "null"]},
        "image_tag": {"type": ["string", "null"]},
        "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_indices", "gpu_uuids", "gpu_model"],
      "properties": {
        "gpu_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "gpu_uuids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "gpu_model": {"type": ["string", "null"]}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openevo_experiment_sha", "upstream_openevo_repo", "upstream_openevo_sha"],
      "properties": {
        "openevo_experiment_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_openevo_repo": {"type": ["string", "null"]},
        "upstream_openevo_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_revision", "tokenizer_revision", "dtype", "adapter_identity"],
      "properties": {
        "model_id": {"type": ["string", "null"]},
        "model_revision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "dtype": {"type": ["string", "null"]},
        "adapter_identity": {"type": ["string", "null"]}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "split", "dataset_revision", "dataset_hash", "index_hash", "task_manifest_identity"],
      "properties": {
        "benchmark": {"type": ["string", "null"]},
        "split": {"type": ["string", "null"]},
        "dataset_revision": {"type": ["string", "null"]},
        "dataset_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "index_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "task_manifest_identity": {"type": ["string", "null"]}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "passport_sha256", "method", "seed", "generation", "config_hash", "gate_evidence"],
      "properties": {
        "experiment_id": {"type": ["string", "null"], "minLength": 1},
        "passport_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "method": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "generation": {"type": ["integer", "null"], "minimum": 0},
        "config_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "gate_evidence": {"type": "object"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "metrics"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_name", "sha256", "locations"],
            "properties": {
              "logical_name": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_gpu_memory_mb", "wall_time_s"],
      "properties": {
        "peak_gpu_memory_mb": {"type": ["number", "null"], "minimum": 0},
        "wall_time_s": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "wandb", "weave"],
      "properties": {
        "mode": {"enum": ["disabled", "offline", "online"]},
        "wandb": {"$ref": "#/$defs/trackingReference"},
        "weave": {"$ref": "#/$defs/trackingReference"}
      }
    }
  },
  "$defs": {
    "trackingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "entity", "project", "id"],
      "properties": {
        "enabled": {"type": "boolean"},
        "entity": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "id": {"type": ["string", "null"]}
      }
    }
  }
}
