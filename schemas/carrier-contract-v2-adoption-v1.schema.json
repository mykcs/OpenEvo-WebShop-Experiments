{
  "$defs": {
    "armBinding": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "minLength": 1,
          "type": "string"
        },
        "carrier_contract_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "execution_git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "health_policy_id": {
          "const": "carrier-health-failure-policy-v1"
        },
        "health_policy_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "health_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "implementation_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "pre_round0_health_status": {
          "const": "PASS"
        },
        "preflight_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "preflight_receipt": {
          "type": "object"
        },
        "scope_package_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scope_policy_id": {
          "const": "webshop-task-local-scope-v1"
        },
        "treatment_role": {
          "enum": [
            "ACCELERATION_ONLY",
            "ACCELERATION_PLUS_GDR"
          ]
        }
      },
      "required": [
        "arm_id",
        "treatment_role",
        "pre_round0_health_status",
        "carrier_contract_identity_sha256",
        "implementation_manifest_sha256",
        "scope_policy_id",
        "scope_package_identity_sha256",
        "health_policy_id",
        "health_policy_identity_sha256",
        "health_schema_sha256",
        "execution_git_sha",
        "preflight_identity_sha256",
        "preflight_receipt"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/mykcs/openevo-experiment/schemas/carrier-contract-v2-adoption-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adoption_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "arm_bindings": {
      "items": {
        "$ref": "#/$defs/armBinding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "formal_task_consumption_allowed": {
      "const": true
    },
    "realized_carrier_payload_parity_required": {
      "const": false
    },
    "schema": {
      "const": "openevo.carrier-contract-v2-adoption.v1"
    },
    "shared_mechanism_parity": {
      "const": "PASS"
    },
    "status": {
      "const": "RESOLVED"
    }
  },
  "required": [
    "schema",
    "status",
    "formal_task_consumption_allowed",
    "shared_mechanism_parity",
    "arm_bindings",
    "realized_carrier_payload_parity_required",
    "adoption_identity_sha256"
  ],
  "title": "Carrier Contract v2 matched-study adoption receipt",
  "type": "object"
}
