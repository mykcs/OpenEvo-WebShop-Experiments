{
  "$id": "openevo.post-channel-dag.202609170650",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenEVO mechanically audited post-rollout fan-out/join DAG",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "openevo.post-channel-dag.202609170650"},
    "dag_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_execution_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_files": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "audit": {"type": "object"},
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollout", "evidence", "text_memory", "sd_lora", "skill_bundle", "agent_system", "task_vector", "retention", "compose_state", "round_seal", "carrier_health"],
      "properties": {
        "rollout": {"$ref": "#/$defs/node"},
        "evidence": {"$ref": "#/$defs/node"},
        "text_memory": {"$ref": "#/$defs/node"},
        "sd_lora": {"$ref": "#/$defs/node"},
        "skill_bundle": {"$ref": "#/$defs/node"},
        "agent_system": {"$ref": "#/$defs/node"},
        "task_vector": {"$ref": "#/$defs/node"},
        "retention": {"$ref": "#/$defs/node"},
        "compose_state": {"$ref": "#/$defs/node"},
        "round_seal": {"$ref": "#/$defs/node"},
        "carrier_health": {"$ref": "#/$defs/node"}
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "minItems": 3
      }
    },
    "prospective_parallel_group": {
      "const": ["text_memory", "sd_lora", "skill_bundle", "agent_system"]
    },
    "join_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_terminal_nodes", "isolated_round_output_paths_required", "channel_scoped_activity_state_required", "atomic_state_commit", "retention_control_sequence_preserved", "carrier_health_after_round_seal"],
      "properties": {
        "required_terminal_nodes": {"const": ["text_memory", "sd_lora", "skill_bundle", "agent_system"]},
        "isolated_round_output_paths_required": {"const": true},
        "channel_scoped_activity_state_required": {"const": true},
        "atomic_state_commit": {"const": true},
        "retention_control_sequence_preserved": {"const": true},
        "carrier_health_after_round_seal": {"const": true}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel_execution_activated", "live_execution_mutated", "scientific_semantics_changed"],
      "properties": {
        "parallel_execution_activated": {"const": false},
        "live_execution_mutated": {"const": false},
        "scientific_semantics_changed": {"const": false}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_authority_granted", "resource_topology_authority_granted", "scientific_retry_authorized"],
      "properties": {
        "scientific_authority_granted": {"const": false},
        "resource_topology_authority_granted": {"const": false},
        "scientific_retry_authorized": {"const": false}
      }
    }
  },
  "required": ["schema", "dag_id", "source_execution_sha", "source_files", "audit", "nodes", "edges", "prospective_parallel_group", "join_contract", "activation", "authority_boundary"],
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "scientific_effect": {"type": "boolean"},
        "control_sequence_preserved": {"type": "boolean"}
      },
      "required": ["reads", "writes"],
      "additionalProperties": false
    }
  }
}
